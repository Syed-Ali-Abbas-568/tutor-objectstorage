{% if OBJSTORAGE_BACKEND == "azure" and OBJSTORAGE_AZURE_ACKNOWLEDGE_RISK %}
# Dev mode runs no Caddy, so OBJSTORAGE_AZURE_HOST (which Caddy would
# otherwise resolve and route) is not reachable as-is: hit the
# authenticated gateway's published port directly instead. See
# local-docker-compose-dev-services.
AWS_S3_ENDPOINT_URL = "{{ "https" if ENABLE_HTTPS else "http" }}://{{ OBJSTORAGE_AZURE_HOST }}:9000"
{% endif %}
